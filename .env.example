# DepegScope Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# API Keys (Optional - for enhanced data collection)
# =============================================================================

# Etherscan API key for on-chain data
# Get yours at: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# CoinGecko API key for higher rate limits
# Get yours at: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# Dune Analytics API key for custom queries
# Get yours at: https://dune.com/settings/api
DUNE_API_KEY=

# The Graph API key for subgraph queries
# Get yours at: https://thegraph.com/studio/
THEGRAPH_API_KEY=

# =============================================================================
# Data Collection Settings
# =============================================================================

# Default number of days for price history
PRICE_HISTORY_DAYS=365

# Minimum TVL for protocol inclusion (in USD)
MIN_PROTOCOL_TVL=1000000

# Minimum pool TVL for inclusion (in USD)
MIN_POOL_TVL=100000

# Number of top protocols to analyze
TOP_PROTOCOLS_COUNT=100

# =============================================================================
# Simulation Settings
# =============================================================================

# Default depeg threshold (2% = 0.02)
DEPEG_THRESHOLD=0.02

# Maximum simulation steps
MAX_SIMULATION_STEPS=100

# Default Monte Carlo runs
MONTE_CARLO_RUNS=1000

# =============================================================================
# Paths (Optional - defaults are usually fine)
# =============================================================================

# Data directory (default: ./data)
# DEPEGSCOPE_DATA_DIR=./data

# Reports directory (default: ./reports)
# DEPEGSCOPE_REPORTS_DIR=./reports

# =============================================================================
# Logging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# Rate Limiting
# =============================================================================

# Delay between API requests (seconds)
API_REQUEST_DELAY=0.5

# Maximum retries for failed requests
API_MAX_RETRIES=3
