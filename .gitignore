# DepegScope .gitignore

# =============================================================================
# Python
# =============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# =============================================================================
# Virtual Environments
# =============================================================================
venv/
ENV/
env/
.venv/
.env/
env.bak/
venv.bak/

# =============================================================================
# IDE / Editors
# =============================================================================
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject

# =============================================================================
# Jupyter Notebooks
# =============================================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# =============================================================================
# Environment Variables / Secrets
# =============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# API Keys and credentials
credentials.json
secrets.json
*.pem
*.key

# =============================================================================
# Data Files
# =============================================================================
# Raw data (can be large)
data/raw/*
!data/raw/.gitkeep

# Processed data
data/processed/*
!data/processed/.gitkeep

# Historical data
data/historical/*
!data/historical/.gitkeep

# Large data files
*.csv
*.parquet
*.pkl
*.pickle
*.h5
*.hdf5

# SQLite databases
*.db
*.sqlite
*.sqlite3

# =============================================================================
# Logs
# =============================================================================
logs/
*.log
log*.txt

# =============================================================================
# OS Generated Files
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# =============================================================================
# Documentation Build
# =============================================================================
site/
docs/_build/
docs/build/

# =============================================================================
# Misc
# =============================================================================
# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Output files
output/
results/
reports/

# Cache
.cache/
*.cache

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff
.ruff_cache/

# pytype
.pytype/

# Cython debug symbols
cython_debug/

# =============================================================================
# Project Specific
# =============================================================================
# Simulation results
simulations/
simulation_results/

# Generated visualizations
figures/
plots/

# Dune query cache
.dune_cache/

# Graph exports
*.gexf
*.graphml
